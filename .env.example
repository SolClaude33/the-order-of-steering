# Public landing configuration, included in the browser build. Never put secrets here.
# HTTPS X/Twitter profile URL, for example https://x.com/orderofsteering.
# Leave empty to hide the navbar X button.
VITE_X_URL=
# EVM token contract address (0x followed by 40 hexadecimal characters).
# Leave empty to hide the contract address in the hero and footer.
VITE_TOKEN_CA=

# Node server configuration. Never use VITE_ for secrets.
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=5174
DATABASE_PATH=.local/order.sqlite

# Persistent storage for Vercel (both required there).
# Leave empty to use SQLite during local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# X developer app: OAuth 2.0 Web App, Read permissions.
# Exact callback: http://127.0.0.1:5173/api/auth/x/callback
# Required scopes: users.read tweet.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# Comma-separated EVM addresses allowed to manage missions and review evidence.
# Access also requires that the wallet has connected X.
KEEPER_WALLETS=

# Required on Vercel: 64 hex characters (32 random bytes), generated securely.
# Use scripts/prepare-vercel-env.mjs to create an ignored import file.
# If empty, a local key is generated and preserved in .local/token-encryption.key.
TOKEN_ENCRYPTION_KEY=
